{
  "name": "blackarrow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node ./scripts/build.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"tests/*.test.mjs\" \"scripts/*.test.mjs\"",
    "test:design-system": "node --import tsx --test \"src/design-system/tests/*.test.ts\" \"src/design-system/tests/*.test.tsx\"",
    "test:design-system:browser": "node --import tsx --test tests/design-system-browser.test.mjs",
    "test:dashboard:browser": "node --import tsx --test tests/dashboard-navigation-e2e.test.mjs",
    "test:services": "node --import tsx --test \"src/services/*.test.ts\"",
    "test:cost-ledger": "node --import tsx --test src/services/ai-provider-call-ledger-service.test.ts src/services/ai-provider-call-ledger-diagnostics-service.test.ts src/services/client-gemini-billing-service.test.ts src/services/universal-outbound-send-service.test.ts src/services/admin-accounting-service.test.ts",
    "start": "node dist/server.cjs"
  },
